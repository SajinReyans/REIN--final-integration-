{
  "name": "weather-monitoring",
  "version": "1.0.0",
  "description": "Local IoT weather monitoring system: ESP32 -> MQTT -> Node.js -> PostgreSQL -> Socket.IO -> EJS/Tailwind dashboard",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "tailwind": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "build": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "mqtt": "^5.10.1",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
