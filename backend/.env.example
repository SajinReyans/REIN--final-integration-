# ==============================
# SERVER
# ==============================
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ==============================
# POSTGRESQL
# ==============================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=weather_monitoring
DATABASE_USER=weather_user
DATABASE_PASSWORD=change_me

# ==============================
# MQTT
# ==============================
# Use YOUR laptop's local IPv4 address here, e.g. mqtt://192.168.1.100:1883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=weather/data
MQTT_CLIENT_ID=weather-node-server

# Optional MQTT auth (leave blank if Mosquitto has no auth configured)
MQTT_USERNAME=
MQTT_PASSWORD=

# React frontend origin when hosted separately. Keep * for unrestricted local testing.
FRONTEND_URL=http://localhost:5173
